# Template for .env. Copy it to .env and fill in the values there.
# Never put real values in this file, and never commit .env.
# An empty value means "not set". Each entry point checks the settings it needs at startup.

# --- Telegram (Step 1.4) ---
# Bot token from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# --- LLM providers (Step 1.6) ---
# Groq API key from the Groq console. Used for Whisper (speech-to-text) and the main LLM.
GROQ_API_KEY=
# Gemini API key from Google AI Studio. Backup LLM (Phase 2).
GEMINI_API_KEY=

# --- Speech-to-text ---
# Groq Whisper model name, for example: whisper-large-v3
STT_MODEL=

# --- Databases (Step 1.2 fills in the exact format) ---
# PostgreSQL connection URL. It contains the database password, so treat it as a secret.
DATABASE_URL=
# Redis connection URL, for example: redis://localhost:6379/0
REDIS_URL=
