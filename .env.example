# Template for .env. Copy it to .env and fill in the values there.
# Never put real values in this file, and never commit .env.
# An empty value means "not set". Each entry point checks the settings it needs at startup.

# --- Telegram (Step 1.4) ---
# Bot token from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# --- Test voice notes (Step 1.5) ---
# Telegram user IDs whose voice notes the bot saves to eval/voice/raw/, as a JSON list,
# for example: [123456789] or [123456789, 987654321]. Empty = nobody's voice notes are saved.
# To find your ID: message the bot and read chat_id=... in its log (private chat: chat ID = user ID).
# Real IDs go only in .env, never in this file.
VOICE_SAVE_USER_IDS=

# --- LLM providers (Step 1.6) ---
# Groq API key from the Groq console. Used for the main LLM (and the Step 1.6 Whisper comparison).
GROQ_API_KEY=
# Gemini API key from Google AI Studio. Backup LLM (Phase 2).
GEMINI_API_KEY=

# --- LLM client (Step 2.4) ---
# Which provider app/services/llm.py talks to: groq or gemini. Empty = groq. It uses that
# provider's key above. To switch provider, change LLM_PROVIDER and LLM_MODEL together.
LLM_PROVIDER=groq
# The model name, written as the provider writes it. openai/gpt-oss-20b = the Step 2.4 test model
# (Groq); the final model is chosen in Step 2.8. Gemini names: eval/llm_smoke_test.py lists them.
# Step 2.4: gemini-2.5-flash answered (about 2 s); gemini-3.8-flash gave no answer in 60 s.
LLM_MODEL=openai/gpt-oss-20b
# Only to use another address than the provider's usual one (llm.py knows Groq's and Gemini's).
LLM_BASE_URL=
# Seconds one try may take. Empty = 10.
LLM_TIMEOUT_SECONDS=
# Seconds for all tries together, waits between them included. Empty = 20.
# Must be at least LLM_TIMEOUT_SECONDS.
LLM_TOTAL_TIMEOUT_SECONDS=
# One JSON line per LLM call with numbers only (tokens, time, model; never text), for Phase 4.
# A relative path starts at the project root. Empty = no file. eval/llm_usage/ is git-ignored.
LLM_USAGE_FILE=eval/llm_usage/usage.jsonl

# --- Speech-to-text ---
# Self-hosted Whisper (faster-whisper) model name. Step 1.6 chose large-v3 (D10 A); medium is the
# backup if the server is too slow. See eval/reports/whisper_phase1.md.
STT_MODEL=large-v3
# Folder for the downloaded Whisper models (several GB). A relative path starts at the project root.
# Empty = Hugging Face's default cache on C:. The folder models/ is git-ignored.
STT_MODEL_DIR=models/whisper

# --- Databases (Step 1.2) ---
# docker-compose.yml reads these 3 to create the Postgres database, for example: srbot / srbot.
# Used only on the first start (empty volume). Changing them later does not change the database.
# Password: letters and digits only, because it goes inside DATABASE_URL below.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# PostgreSQL connection URL, built from the 3 values above (keep them above this line).
# 127.0.0.1, not localhost: on Windows, localhost may try IPv6 first, but the port is IPv4 only.
# The app adds the driver itself (+asyncpg, app/db/session.py, Step 2.2); postgresql+asyncpg://
# works too. pytest uses the same URL with "_test" added to the database name (srbot_test).
# It contains the password: a secret.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
# Redis connection URL: database 0, no password (only this laptop can reach it).
# pytest uses the same URL with database 15 instead of 0, and empties it (Step 2.3).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Session memory (Step 2.3) ---
# Seconds without a new message before a chat's session and history are deleted. Every new message
# starts the timer again. Empty = 1800 (the brief's 30 minutes). Must be a whole number above 0.
SESSION_TTL_SECONDS=
# How many recent messages (user or bot) the history keeps for the LLM. Empty = 10, a placeholder
# until the token budget is set. Must be a whole number above 0.
HISTORY_MAX_MESSAGES=
